  "loadSpeedIndex": {
    "optional": true,
    "exposedOptions": null,
    "notes": [
      "Continental describes this field as load index + speed rating.",
      "The public crawl exposed the field but not the dropdown enumeration.",
      "Passenger tire load indices are described by Continental as spanning 75 to 105, and speed ratings use letters A to Z."
    ],
    "schema": {
      "loadIndex": {
        "type": "integer",
        "minimum": 75,
        "maximum": 105
      },
      "speedRating": {
        "type": "string",
        "pattern": "^[A-Z]$",
        "examples": [
          "H",
          "V",
          "W",
          "Y"
        ]
      }
    }
  }
