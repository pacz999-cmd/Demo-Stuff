<?xml version="1.0" encoding="UTF-8"?>
<!-- orderTracker.js-meta.xml -->
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>58.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>B2B Order Tracker</masterLabel>
    <description>Displays order shipment progress on a map for B2B Commerce.</description>
    <targets>
        <target>lightningCommunity__Page</target>
        <target>lightningCommunity__Default</target>
        <target>lightning__RecordPage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightningCommunity__Default">
            <property name="recordId" type="String" label="Order ID" default="{!recordId}"/>
            <property name="warehouseStreet" type="String" label="Warehouse Street" default="Schlüterstraße 3"/>
            <property name="warehousePostalCode" type="String" label="Warehouse ZIP code" default="40235"/>
            <property name="warehouseCity" type="String" label="Warehouse City" default="Düsseldorf"/>
            <property name="warehouseCountry" type="String" label="Warehouse Country" default="Germany"/>
            <property name="deliveryStreet" type="String" label="Delivery Street (legacy fallback)"/>
            <property name="deliveryPostalCode" type="String" label="Delivery ZIP code (legacy fallback)"/>
            <property name="deliveryCity" type="String" label="Delivery City (legacy fallback)"/>
            <property name="deliveryCountry" type="String" label="Delivery Country (legacy fallback)"/>
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>